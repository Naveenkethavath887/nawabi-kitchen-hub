@page "/takeaway"
@using System.Text.Json
@inject IOrderService OrderService

@* Pass this in from a parent page or set a default here *@
@code {
    [Parameter] public bool IsAdmin { get; set; } = true;
}

<div class="min-vh-100 py-4">
    <div class="container">
        <div class="text-center text-lg-start mb-3">
            <h1 class="fw-bold text-success">Takeaway Menu</h1>

            @if (IsAdmin)
            {
                <div class="card border-success-subtle mb-3">
                    <div class="card-header text-success fw-semibold">Customer Details</div>
                    <div class="card-body">
                        <div class="row g-2">
                            <div class="col-md-4">
                                <input class="form-control" placeholder="Customer Name" @bind="CustomerName" />
                            </div>
                            <div class="col-md-4">
                                <input class="form-control" placeholder="Phone Number" @bind="CustomerPhone" />
                            </div>
                            <div class="col-md-4">
                                <input class="form-control" placeholder="Collection Time" @bind="CollectionTime" />
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Category Filters -->
        <div class="mb-3">
            <div class="d-flex flex-wrap gap-2 justify-content-center justify-content-lg-start">
                <button class="btn @(SelectedCategory == "all" ? "btn-success" : "btn-outline-success")"
                        @onclick="() => SelectCategory("all")">
                    All
                </button>

                @foreach (var c in MenuCategories)
                {
                    var key = Keyify(c.Title);
                    <button class="btn @(SelectedCategory == key ? "btn-success" : "btn-outline-success")"
                            @onclick="() => SelectCategory(key)">
                        @c.Title
                    </button>
                }
            </div>
        </div>

        <div class="row g-3">
            <!-- Menu -->
            <div class="@((SelectedCategory == "all") ? "col-12 col-xl-9" : "col-12")">
                @if (SelectedCategory == "all")
                {
                    <div class="row g-3">
                        @foreach (var category in FilteredCategories)
                        {
                            <div class="col-12 col-lg-6">
                                <div class="card border-success-subtle h-100">
                                    <div class="card-header d-flex align-items-center justify-content-between">
                                        <span class="fw-semibold text-success">@category.Title</span>
                                        <span class="badge rounded-pill @GetTypeBadgeClass(category.Title)">
                                            @category.Items.Count @("items")
                                        </span>
                                    </div>
                                    <div class="list-group list-group-flush">
                                        @for (int i = 0; i < category.Items.Count; i++)
                                        {
                                            var item = category.Items[i];
                                            <button disabled="@(!IsAdmin)"
                                                    class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                                                    @onclick="() => AddToCart(item.Name, category.Title)">
                                                <span class="text-wrap">@item.Name</span>
                                                <span class="fw-semibold text-success">@item.PriceString</span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    @foreach (var category in FilteredCategories)
                    {
                        <div class="mb-2 d-flex align-items-center gap-2">
                            <h2 class="h4 m-0 text-success fw-bold">@category.Title</h2>
                            <span class="badge rounded-pill @GetTypeBadgeClass(category.Title)">
                                @category.Items.Count @("items")
                            </span>
                        </div>

                        <div class="row g-3">
                            @foreach (var item in category.Items)
                            {
                                <div class="col-12 col-sm-6 col-lg-4">
                                    <div class="card border-success-subtle h-100 @(IsAdmin ? "hover-shadow" : null)"
                                         style="cursor:@(IsAdmin ? "pointer" : "default")"
                                         @onclick="() => { if (IsAdmin) AddToCart(item.Name, category.Title); }">
                                        <div class="card-body text-center">
                                            <div class="fw-semibold mb-2">@item.Name</div>
                                            <div class="fs-5 fw-bold text-success">@item.PriceString</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
            </div>

            <!-- Cart (sidebar when All; separate col in single view) -->
            @if (IsAdmin && (SelectedCategory == "all"))
            {
                <div class="col-12 col-xl-3">
                    @CartCard()
                </div>
            }
        </div>

        @if (IsAdmin && SelectedCategory != "all")
        {
            <div class="mt-3">
                @CartCard()
            </div>
        }

        <!-- Complimentary Sides Modal -->
        @if (ShowSidesDialog && SelectedMainCourse is not null)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color:rgba(0,0,0,.5);" role="dialog">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title text-success">Choose Your Complimentary Side</h5>
                            <button type="button" class="btn-close" @onclick="() => ShowSidesDialog = false"></button>
                        </div>
                        <div class="modal-body">
                            <p class="text-muted">
                                Select one complimentary side dish with your @SelectedMainCourse!.Name
                            </p>
                            <div class="row g-2">
                                @foreach (var side in MenuCategories.First(c => c.Title == "Sides").Items)
                                {
                                    <div class="col-12 col-sm-6">
                                        <div class="card border-success-subtle h-100"
                                             style="cursor:pointer"
                                             @onclick="() => AddMainCourseWithSide(side.Name)">
                                            <div class="card-body text-center">
                                                <div class="fw-semibold mb-1">@side.Name</div>
                                                <div class="small text-success fw-semibold">Complimentary</div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!IsAdmin)
        {
            <div class="mt-4 text-center text-muted small">
                All dishes are prepared with authentic spices and traditional cooking methods
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(ToastMessage))
        {
            <div class="toast-container position-fixed bottom-0 end-0 p-3">
                <div class="toast show align-items-center text-bg-@ToastType border-0">
                    <div class="d-flex">
                        <div class="toast-body">@ToastMessage</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" @onclick="() => ToastMessage = string.Empty"></button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    // ---------- Models ----------
    public record MenuItem(string Name, decimal Price)
    {
        public string PriceString => $"€{Price:0.00}";
    }

    public class MenuCategory
    {
        public string Title { get; set; } = default!;
        public List<MenuItem> Items { get; set; } = new();
    }

    public class OrderItem
    {
        public string Name { get; set; } = default!;
        public string Category { get; set; } = default!;
        public int Quantity { get; set; }
    }

    public class TakeawayOrder
    {
        public int Id { get; set; }                 // DB-generated
        public string CustomerName { get; set; } = default!;
        public string CustomerPhone { get; set; } = string.Empty;
        public List<OrderItem> Items { get; set; } = new();
        public int TotalItems { get; set; }
        public string Status { get; set; } = "pending";
        public string Notes { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; } = DateTime.UtcNow;
    }

    // ---------- State ----------
    private string SelectedCategory = "all";
    private List<OrderItem> Cart = new();
    private string CustomerName = string.Empty;
    private string CustomerPhone = string.Empty;
    private string CollectionTime = string.Empty;

    private bool ShowSidesDialog = false;
    private (string Name, string Category)? SelectedMainCourse;

    private string ToastMessage = string.Empty;
    private string ToastType = "success"; // success | danger | warning | info

    // ---------- Data ----------
    private readonly List<MenuCategory> MenuCategories = new()
    {
        new() {
            Title = "Veg Appetisers",
            Items = new() {
                new("Onion Bajji", 7.95m), new("Gobi Manchurian", 8.95m), new("Crispy Corn", 7.95m),
                new("Paneer Tikka", 10.95m), new("Chilly Paneer", 10.95m), new("Paneer 65", 10.95m)
            }
        },
        new() {
            Title = "Non-Veg Appetisers",
            Items = new() {
                new("Chicken Manchurian", 9.95m), new("Chicken Lollipop", 10.95m), new("Chicken Wings", 9.95m),
                new("Chilly Chicken", 10.95m), new("Chicken Tikka", 10.95m), new("Cashew Chicken", 10.95m),
                new("Prawns Tikka", 13.95m)
            }
        },
        new() {
            Title = "Veg Main Course",
            Items = new() {
                new("Kadai Mixed Veg", 13.95m), new("Dal Tadka", 10.95m), new("Nizami Veg Korma", 12.95m),
                new("Paneer Butter Masala", 20.95m), new("Paneer Tikka Masala", 20.95m)
            }
        },
        new() {
            Title = "Non-Veg Main Course",
            Items = new() {
                new("Chicken Curry", 17.95m), new("Butter Chicken", 18.50m), new("Chicken Butter Masala", 18.95m),
                new("Andhra Chicken Curry", 18.95m), new("Andhra Boneless Chicken Curry", 20.95m),
                new("Nizami Chicken Boneless", 19.95m)
            }
        },
        new() {
            Title = "Biryanis",
            Items = new() {
                new("Egg Biryani", 17.95m), new("Veg Biryani", 17.95m), new("Chicken Biryani", 21.95m),
                new("Mutton Biryani", 24.95m), new("Prawns Biryani", 24.95m), new("Nawabi Lamb Biryani", 24.95m),
                new("Vijayawada Boneless Biryani", 22.95m),
                new("Special Biryani (Chicken)", 25.50m), new("Special Biryani (Mutton)", 25.50m),
                new("Special Biryani (Prawn)", 25.50m), new("Special Biryani (Lamb)", 25.50m)
            }
        },
        new() {
            Title = "Tiffins",
            Items = new() {
                new("Idly", 6.95m), new("Medu Vada (2 pcs)", 7.95m), new("Sambar Idly", 8.95m), new("Sambar Vada", 9.95m),
                new("Plain Dosa", 9.95m), new("Masala Dosa", 10.95m), new("Onion Dosa", 10.95m),
                new("Paneer Dosa", 11.95m), new("Rava Dosa", 11.95m), new("Onion Rava Dosa", 12.95m),
                new("Mysore Masala Dosa", 12.95m), new("Ghee Roast Dosa", 13.95m),
                new("Pesarattu Upma Dosa", 13.95m), new("Family Dosa", 21.95m)
            }
        },
        new() {
            Title = "Kids Menu",
            Items = new() {
                new("Chicken Goujons (7)", 7.95m), new("Fish Fingers (4)", 7.95m), new("Chicken Nuggets (7)", 7.95m),
                new("Kids Masala Dosa", 6.95m)
            }
        },
        new() {
            Title = "Sides",
            Items = new() {
                new("Plain Naan", 3.25m), new("Butter Naan", 3.50m), new("Garlic Naan", 4.00m),
                new("Peshawari Naan", 4.50m), new("Special Baghara Rice", 6.95m)
            }
        },
        new() {
            Title = "Desserts",
            Items = new() { new("Double Ka Meeta", 4.95m), new("Gulab Jamun (2 pcs)", 4.95m) }
        },
        new() {
            Title = "Beverages",
            Items = new() {
                new("Coke", 3.50m), new("Fanta", 3.50m), new("Sprite", 3.50m), new("Water", 3.50m),
                new("Sweet Lassi", 4.95m), new("Salt Lassi", 4.95m)
            }
        }
    };

    private IEnumerable<MenuCategory> FilteredCategories =>
        SelectedCategory == "all"
            ? MenuCategories
            : MenuCategories.Where(c => Keyify(c.Title) == SelectedCategory);

    // ---------- UI Helpers ----------
    private void SelectCategory(string key) => SelectedCategory = key;

    private static string Keyify(string s) =>
        new string(s.ToLower().Where(ch => !(ch == ' ' || ch == '-')).ToArray());

    private string GetTypeBadgeClass(string title)
    {
        var t = title.ToLowerInvariant();
        if (t.Contains("veg") && !t.Contains("non-veg")) return "text-bg-success";
        if (t.Contains("non-veg")) return "text-bg-danger";
        if (t.Contains("biryani")) return "text-bg-warning";
        if (t.Contains("tiffin")) return "text-bg-primary";
        if (t.Contains("beverage")) return "text-bg-info";
        if (t.Contains("dessert")) return "text-bg-pink"; // may need custom class
        if (t.Contains("kids")) return "text-bg-secondary";
        return "text-bg-light";
    }

    // ---------- Pricing/Cart ----------
    private decimal GetItemPrice(string itemName)
    {
        foreach (var c in MenuCategories)
        {
            var item = c.Items.FirstOrDefault(i => i.Name == itemName);
            if (item is not null) return item.Price;
        }
        return 0m;
    }

    private void AddToCart(string itemName, string categoryTitle)
    {
        if (!IsAdmin)
        {
            Toast("Only admin can create orders", "danger");
            return;
        }

        if (categoryTitle is "Veg Main Course" or "Non-Veg Main Course")
        {
            SelectedMainCourse = (itemName, categoryTitle);
            ShowSidesDialog = true;
            return;
        }

        var existing = Cart.FirstOrDefault(i => i.Name == itemName);
        if (existing is not null)
        {
            existing.Quantity += 1;
        }
        else
        {
            Cart.Add(new OrderItem { Name = itemName, Category = categoryTitle, Quantity = 1 });
        }

        Toast($"Added {itemName} to cart", "success");
        StateHasChanged();
    }

    private void AddMainCourseWithSide(string sideItemName)
    {
        if (SelectedMainCourse is null) return;

        // Main course
        var main = Cart.FirstOrDefault(i => i.Name == SelectedMainCourse.Value.Name);
        if (main is not null) main.Quantity += 1;
        else Cart.Add(new OrderItem
        {
            Name = SelectedMainCourse.Value.Name,
            Category = SelectedMainCourse.Value.Category,
            Quantity = 1
        });

        // Complimentary side
        var sideKey = $"{sideItemName} (Complimentary)";
        var side = Cart.FirstOrDefault(i => i.Name == sideKey);
        if (side is not null) side.Quantity += 1;
        else Cart.Add(new OrderItem
        {
            Name = sideKey,
            Category = "Sides",
            Quantity = 1
        });

        ShowSidesDialog = false;
        Toast($"Added {SelectedMainCourse.Value.Name} with complimentary {sideItemName} to cart", "success");
        SelectedMainCourse = null;
    }

    private void RemoveFromCart(string itemName)
    {
        var it = Cart.FirstOrDefault(i => i.Name == itemName);
        if (it is null) return;
        if (it.Quantity > 1) it.Quantity -= 1;
        else Cart.Remove(it);
    }

    private int GetTotalItems() => Cart.Sum(i => i.Quantity);

    private decimal GetTotalPrice()
    {
        decimal total = 0m;
        foreach (var i in Cart)
        {
            var name = i.Name.Replace(" (Complimentary)", "");
            if (i.Name.Contains("(Complimentary)")) continue;
            total += GetItemPrice(name) * i.Quantity;
        }
        return total;
    }

    private RenderFragment CartCard() => (__builder) =>
    {
        <div class="card border-success-subtle position-sticky" style="top:1rem;">
            <div class="card-header d-flex justify-content-between align-items-center text-success">
                <div class="d-flex align-items-center gap-2">
                    <span class="bi bi-cart"></span>
                    <span>Cart (@GetTotalItems())</span>
                </div>
                <div class="small fw-semibold">€@GetTotalPrice().ToString("0.00")</div>
            </div>
            <div class="card-body">
                <div class="d-flex flex-column gap-2" style="max-height:16rem;overflow:auto;">
                    @if (Cart.Count == 0)
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-cart fs-1 d-block mb-2"></i>
                            <div class="small">Cart is empty</div>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in Cart)
                        {
                            <div class="d-flex justify-content-between align-items-center border rounded p-2 bg-light">
                                <div class="me-2">
                                    <div class="fw-medium small">@item.Name</div>
                                    <div class="text-muted small">@item.Category</div>
                                    <div class="text-success small fw-semibold">
                                        @((item.Name.Contains("(Complimentary)")) ? "Free" :
                                            $"€{(GetItemPrice(item.Name.Replace(" (Complimentary)", "")) * item.Quantity):0.00}")
                                    </div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <button class="btn btn-sm btn-outline-success"
                                            @onclick="() => RemoveFromCart(item.Name)">
                                        <i class="bi bi-dash-lg"></i>
                                    </button>
                                    <span class="small fw-semibold">@item.Quantity</span>
                                    <button class="btn btn-sm btn-outline-success"
                                            @onclick="() => AddToCart(item.Name, item.Category)">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>

                @if (Cart.Count > 0)
                {
                    <hr />
                    <div class="d-flex justify-content-between align-items-center fw-semibold mb-2">
                        <span>Total:</span>
                        <span class="text-success">€@GetTotalPrice().ToString("0.00")</span>
                    </div>
                    <button class="btn btn-success w-100"
                            disabled="@(Cart.Count == 0 || string.IsNullOrWhiteSpace(CustomerName))"
                            @onclick="CreateOrderAsync">
                        Create Order
                    </button>
                }
            </div>
        </div>;
    };

    // ---------- Save / Service ----------
    private async Task CreateOrderAsync()
    {
        if (Cart.Count == 0) { Toast("Cart is empty", "danger"); return; }
        if (string.IsNullOrWhiteSpace(CustomerName)) { Toast("Customer name is required", "danger"); return; }

        try
        {
            var order = new TakeawayOrder
            {
                CustomerName = CustomerName.Trim(),
                CustomerPhone = CustomerPhone.Trim(),
                Items = Cart.Select(c => new OrderItem { Name = c.Name, Category = c.Category, Quantity = c.Quantity }).ToList(),
                TotalItems = GetTotalItems(),
                Status = "pending",
                Notes = string.Empty
            };

            var created = await OrderService.CreateOrderAsync(order);

            Toast($"Order #{created.Id} created successfully!", "success");
            Cart.Clear();
            CustomerName = CustomerPhone = CollectionTime = string.Empty;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(ex);
            Toast("Failed to create order. Please try again.", "danger");
        }
    }

    // ---------- Toast ----------
    private void Toast(string message, string type = "success")
    {
        ToastMessage = message;
        ToastType = type;
        // Auto-hide after a bit (optional): In Blazor, you could use a timer; keeping manual close for simplicity.
    }
}
